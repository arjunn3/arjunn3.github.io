---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="foot">
    <span>{site.logo} · {year}</span>
    <span class="links">
      <a href={site.github} rel="me">github</a>
      <a href={`mailto:${site.email}`}>email</a>
      {site.linkedin && <a href={site.linkedin} rel="me">linkedin</a>}
    </span>
  </div>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 28px 40px;
    margin-top: 72px;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--label);
  }

  .links {
    display: flex;
    gap: 20px;
  }

  .links a {
    color: var(--label);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
