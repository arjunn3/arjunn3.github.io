---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroGraph from '../components/HeroGraph.astro';
import SayHi from '../components/SayHi.astro';
import Tile from '../components/Tile.astro';
import Visual from '../components/Visual.astro';
import { site } from '../data/site';
import { daysSince, isStale } from '../lib/now';
import { areaInfo, featuredWork, groupByArea, homeTiles, visibleWork } from '../lib/work';

const all = visibleWork(await getCollection('work'), { includeDrafts: import.meta.env.DEV });
const featured = featuredWork(all);
const areas = groupByArea(all.filter((e) => e.data.group === 'orfiq'));

const [now] = await getCollection('now');
if (!now) throw new Error('src/content/now.md is missing');
const today = new Date();
if (isStale(now.data.updated, today)) {
  console.warn(`[now] now.md was last updated ${daysSince(now.data.updated, today)} days ago — time for a refresh?`);
}
const nowDate = now.data.updated
  .toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })
  .toLowerCase();

const side = all.find((e) => e.data.group === 'personal' && e.data.page !== false);
const tiles = homeTiles(all, { exclude: featured ? [featured.id] : [], count: side ? 2 : 3 });
const areaLabel = (e: (typeof all)[number]) => (e.data.area ? areaInfo[e.data.area].label : e.data.group);
---

<Base title="" description={site.description} path="/">
  <section class="hero wrap">
    <div class="copy">
      <p class="kicker">
        <b>//</b>{' '}{site.role.toLowerCase()} · {site.org.toLowerCase()} · {site.location.toLowerCase()}
      </p>
      <h1>I build AI systems that <em>stay grounded.</em></h1>
      <p class="lede">
        I design and build production LLM systems: pipelines grounded in knowledge graphs, long-running jobs that
        survive failure, and the validation layers that catch model mistakes. Right now that's AI for medical education
        at Orfiq.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/work/">See the work <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/about/">about me</a>
      </div>
    </div>
    <HeroGraph />
  </section>

  <section class="wrap areas" aria-labelledby="areas-title">
    <h2 id="areas-title" class="section-title">What I work on</h2>
    <div class="area-grid">
      {
        areas.map((a, i) => (
          <a class="area lift" href={`/work/#${a.area}`}>
            <span class="area-n">0{i + 1}</span>
            <h3>{a.label}</h3>
            <p>{a.blurb}</p>
            <span class="area-count">
              {a.items.length} system{a.items.length === 1 ? '' : 's'} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="glance wrap" aria-labelledby="glance-title">
    <div class="glance-head">
      <h2 id="glance-title" class="section-title">At a glance</h2>
      <a class="more" href="/work/">all work <span aria-hidden="true">→</span></a>
    </div>

    <div class="grid">
      {
        featured && (
          <Tile href={`/work/${featured.id}/`} class="t-feat">
            <div class="feat-copy">
              <p class="tile-label">featured · {areaLabel(featured)}</p>
              <h3 class="tile-title">{featured.data.title}</h3>
              <p class="tile-text">{featured.data.summary}</p>
              <ul class="chips">
                {featured.data.stack.slice(0, 3).map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
            <Visual kind={featured.data.visual} steps={featured.data.steps} />
          </Tile>
        )
      }

      <Tile href="/now/" class="t-now">
        <p class="tile-label">
          <span class="live" aria-hidden="true"></span>now<span class="now-date">{nowDate}</span>
        </p>
        <h3 class="tile-title">{now.data.title}</h3>
        <p class="tile-text">{now.data.summary}</p>
      </Tile>

      <Tile class="t-stack">
        <p class="tile-label">stack</p>
        <ul class="chips">
          {site.stack.map((s) => <li>{s}</li>)}
        </ul>
      </Tile>

      {
        tiles.map((t) => (
          <Tile href={`/work/${t.id}/`}>
            <p class="tile-label">{areaLabel(t)}</p>
            <h3 class="tile-title">{t.data.title}</h3>
            <Visual kind={t.data.visual} steps={t.data.steps} />
          </Tile>
        ))
      }

      {
        side && (
          <Tile href={`/work/${side.id}/`} class="t-side">
            <p class="tile-label">side project</p>
            <h3 class="tile-title">{side.data.title}</h3>
            <p class="tile-text side-text">{side.data.summary}</p>
            <Visual kind={side.data.visual} />
          </Tile>
        )
      }

      <Tile href="/about/#taekwondo" class="t-tkd">
        <p class="tile-label">off the keyboard</p>
        <h3 class="tile-title">Taekwondo</h3>
        <p class="tile-text">{site.taekwondo}</p>
        <span class="v-belt" aria-hidden="true"></span>
      </Tile>

      <SayHi class="t-hi" />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: 40px;
    align-items: center;
    padding-block: 60px 64px;
  }

  .kicker {
    margin-bottom: 22px;
  }

  h1 {
    font-size: clamp(38px, 5.2vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.028em;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--secondary);
    max-width: 520px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 32px;
  }

  .section-title {
    font-size: 20px;
    letter-spacing: -0.01em;
  }

  .areas {
    margin-bottom: 64px;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 18px;
  }

  .area {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--r-tile);
    background: linear-gradient(180deg, rgba(15, 21, 28, 0.9), rgba(15, 21, 28, 0.5));
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .area:hover {
    border-color: var(--border-hover);
    color: var(--text);
  }

  .area-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .area h3 {
    font-size: 19px;
    margin-top: 10px;
  }

  .area p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--secondary);
    flex: 1;
  }

  .area-count {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--label);
  }

  .area:hover .area-count {
    color: var(--accent);
  }

  .glance-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 18px;
  }

  .more {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--secondary);
    text-decoration: none;
  }

  .more:hover {
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .grid > :global(.tile:not(.t-hi)) {
    min-height: 176px;
  }

  .grid :global(.t-feat) {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 196px);
    gap: 18px;
  }

  .grid :global(.t-now) {
    border-color: var(--accent-soft);
    background:
      linear-gradient(180deg, rgba(94, 234, 212, 0.08), rgba(94, 234, 212, 0) 65%),
      var(--surface);
  }

  .grid :global(.t-now .tile-label) {
    color: var(--accent);
  }

  .now-date {
    margin-left: auto;
    color: var(--label);
  }

  .grid :global(.t-side),
  .grid :global(.t-tkd) {
    overflow: hidden;
  }

  .side-text {
    max-width: 130px;
  }

  .grid :global(.t-hi) {
    grid-column: 1 / -1;
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 44px 48px;
    }

    .grid,
    .area-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid :global(.t-feat) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .grid,
    .area-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .grid :global(.t-feat) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
