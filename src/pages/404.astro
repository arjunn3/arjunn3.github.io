---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist on Arjun Nagendra's site. Try the work page or go back home." path="/404/">
  <section class="wrap lost">
    <p class="kicker"><b>//</b> 404</p>
    <h1>No node here.</h1>
    <p class="muted">This path doesn't lead anywhere in the graph. It may have moved, or never existed.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="text-link" href="/work/">see the work</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    padding-block: 96px 48px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 60px);
    letter-spacing: -0.03em;
    margin-top: 14px;
  }

  .muted {
    margin-top: 16px;
    font-size: 17px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 32px;
  }
</style>
